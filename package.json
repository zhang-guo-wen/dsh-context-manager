{
  "name": "@guowenzhang/dsh-context-manager",
  "version": "0.1.0",
  "description": "Inspect and edit workspace Skills, instructions, and prompt context in DeepSeek Harness",
  "type": "module",
  "license": "Apache-2.0",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "engines": { "node": ">=22", "dsh": ">=0.1.7-0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "README.zh.md", "LICENSE"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsdown -c tsdown.config.ts && node build-client.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent-instructions": ">=0.1.7-0",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.1.7-0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.7-0",
    "@deepseek-ai/dsh-skill": ">=0.1.7-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.7-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.7-0",
    "@deepseek-ai/dsh-workspace": ">=0.1.7-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-0",
    "react": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-agent-instructions": ">=0.1.7-0",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.1.7-0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.7-0",
    "@deepseek-ai/dsh-skill": ">=0.1.7-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.7-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.7-0",
    "@deepseek-ai/dsh-workspace": ">=0.1.7-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-0",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-0",
    "@types/node": "^26.5.0",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "rolldown": "^1.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
