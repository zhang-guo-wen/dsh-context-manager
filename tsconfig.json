{
  "compilerOptions": {
    "target": "es2024", "module": "esnext", "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM"], "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "skipLibCheck": true,
    "verbatimModuleSyntax": true, "allowImportingTsExtensions": true,
    "noEmit": true, "types": ["node"], "jsx": "react-jsx"
  },
  "include": ["src", "tests"]
}
